# ===== CCTV AI — Environment Configuration =====
# Copy this file to .env and fill in your values. NEVER commit .env.

# --- Backend ---
# PostgreSQL connection string (local or Docker service name "postgres")
DATABASE_URL=postgresql+psycopg2://cctv:CCTV_secret_change_me@localhost:5432/cctv_ai

# Redis (used for optional caching / pub-sub; service name "redis" in Docker)
REDIS_URL=redis://localhost:6379/0

# Secret key for signing tokens / session data — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_random_hex_string

# --- AI Models ---
# YOLO model to load. yolov8n.pt = fastest/smallest, yolov8s.pt = balanced.
# Leave empty to auto-download yolov8n.pt on first run.
YOLO_MODEL=yolov8n.pt
# Detection confidence threshold (0.0 - 1.0)
DETECTION_CONFIDENCE=0.35
# Frame processing rate (frames per second to analyze). Lower = less CPU/GPU.
PROCESS_FPS=15

# --- Feature toggles ---
ENABLE_FACE_RECOGNITION=false
ENABLE_ANPR=true
ENABLE_MOTION_DETECTION=true

# --- Storage ---
# Root folder for snapshots/recordings/plates/faces
STORAGE_ROOT=./storage

# --- Security ---
# Comma-separated list of allowed CORS origins (frontend dev/prod URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Frontend (Vite) ---
VITE_API_BASE=http://localhost:8000/api
VITE_WS_BASE=ws://localhost:8000/ws
